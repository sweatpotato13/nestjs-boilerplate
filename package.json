{
    "name": "nestjs-boilerplate",
    "version": "0.0.1",
    "description": "",
    "author": "Cute_Wisp",
    "private": true,
    "license": "UNLICENSED",
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "prettier",
            "pnpm lint",
            "pnpm prisma:format"
        ],
        "*.{md,json}": [
            "prettier --write"
        ]
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
        "prettier": "prettier --write \"src/**/*.ts\"",
        "prestart": "yarn run types",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node -r ./tsconfig-paths-bootstrap.js dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
        "sdk": "nestia sdk 'src/**/*.controller.ts' --out 'src/api'",
        "swagger": "nestia swagger 'src/**/*.controller.ts' --out './public/swagger.json'",
        "prisma:migrate": "prisma migrate dev",
        "prisma:generate": "prisma generate",
        "prisma:studio": "prisma studio",
        "prisma:format": "prisma format",
        "prepare": "ts-patch install && typia patch && husky"
    },
    "dependencies": {
        "@elastic/elasticsearch": "^9.5.0",
        "@nestia/e2e": "^11.3.4",
        "@nestia/fetcher": "^11.3.4",
        "@nestia/sdk": "^11.3.4",
        "@nestjs-modules/mailer": "^2.3.7",
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.1",
        "@nestjs/cqrs": "^12.0.0",
        "@nestjs/elasticsearch": "^12.0.0",
        "@nestjs/microservices": "^12.0.1",
        "@nestjs/mongoose": "^12.0.0",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.0.1",
        "@nestjs/swagger": "^12.0.1",
        "@prisma/client": "^6.19.3",
        "body-parser": "^2.3.0",
        "bs58": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cls-rtracer": "^2.6.4",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "kafkajs": "^2.2.4",
        "moment": "^2.30.1",
        "mongoose": "^9.9.4",
        "morgan": "^1.12.0",
        "object-assign": "^4.1.1",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "pg": "^8.23.0",
        "prisma": "^6.19.3",
        "prisma-class-generator": "^0.2.11",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "tsconfig-paths": "^4.2.0",
        "typedi": "^0.10.0",
        "typia": "^12.1.1",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@jest/globals": "30.5.0",
        "@nestia/benchmark": "^11.3.4",
        "@nestia/core": "^11.3.4",
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.16.1",
        "@types/express": "^5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "^22.20.1",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/xml2js": "^0.4.14",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-security": "^4.0.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jest": "30.5.0",
        "lint-staged": "^17.4.1",
        "nestia": "^11.3.4",
        "node-mocks-http": "^1.18.1",
        "prettier": "^3.9.6",
        "prisma-markdown": "^3.0.1",
        "rimraf": "^6.1.3",
        "supertest": "^7.2.2",
        "ts-jest": "29.4.12",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "ts-patch": "^4.0.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.68.0"
    },
    "peerDependencies": {
        "webpack": "^5.90.3"
    }
}
